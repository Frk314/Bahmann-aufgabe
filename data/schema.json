{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Laborsuche DACH providers",
  "description": "Contract between the data pipeline and the map/API. New categories or services can be added without breaking existing consumers.",
  "type": "object",
  "required": ["schema_version", "providers"],
  "properties": {
    "schema_version": { "type": "string" },
    "providers": { "type": "array", "items": { "$ref": "#/$defs/provider" } }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "required": ["id", "name", "category", "categories", "provider_type", "services", "address", "coordinates", "contact", "self_pay", "prices", "source_url", "verification"],
      "properties": {
        "id": { "type": "string", "description": "Google place_id (stable across pipeline runs)" },
        "name": { "type": "string", "minLength": 1 },
        "category": {
          "enum": ["DEXA", "Blood Test"],
          "description": "Main category for the map (DEXA if both are offered); 'categories' has the full list"
        },
        "source_url": { "type": ["string", "null"], "description": "Same as verification.source_url, used by the map frontend" },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["dexa", "blood_lab"] }
        },
        "provider_type": { "enum": ["lab", "practice"] },
        "services": {
          "type": "object",
          "required": ["body_composition", "bone_density", "blood_test_self_pay"],
          "additionalProperties": { "type": "boolean" }
        },
        "address": {
          "type": "object",
          "required": ["street", "postal_code", "city", "country"],
          "properties": {
            "street": { "type": ["string", "null"] },
            "postal_code": { "type": ["string", "null"], "pattern": "^[0-9]{4,5}$" },
            "city": { "type": ["string", "null"] },
            "country": { "enum": ["DE", "AT", "CH"] }
          }
        },
        "coordinates": {
          "type": "object",
          "required": ["lat", "lng"],
          "properties": {
            "lat": { "type": "number", "minimum": 45.5, "maximum": 55.5 },
            "lng": { "type": "number", "minimum": 5.5, "maximum": 17.5 }
          }
        },
        "contact": {
          "type": "object",
          "required": ["phone", "website"],
          "properties": {
            "phone": { "type": ["string", "null"] },
            "website": { "type": ["string", "null"], "format": "uri" }
          }
        },
        "self_pay": { "type": ["boolean", "null"], "description": "null = unknown" },
        "prices": {
          "type": "object",
          "required": ["publicly_available", "note"],
          "properties": {
            "publicly_available": { "type": "boolean" },
            "note": { "type": ["string", "null"], "description": "e.g. 'DEXA Ganzkörper 89 €'" }
          }
        },
        "verification": {
          "type": "object",
          "required": ["verified", "source_url", "evidence"],
          "properties": {
            "verified": { "type": "boolean", "description": "true = checked by hand on the provider's website" },
            "source_url": { "type": ["string", "null"] },
            "evidence": { "type": ["string", "null"], "description": "text passage the classification is based on" },
            "note": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}
